{
  "name": "linked-lovelace-ui",
  "version": "2.2.5",
  "description": "A front-end library that allows for template creation and re-use in Home Assistant's Lovelace UI",
  "module": "linked-lovelace-ui.js",
  "repository": "https://github.com/daredoes/linked-lovelace-ui",
  "author": "Daniel Evans <me@daredoes.work>",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@lit-labs/scoped-registry-mixin": "^1.0.4",
    "custom-card-helpers": "^1.9.0",
    "eta": "./eta-3.0.3.tgz",
    "home-assistant-js-websocket": "^8.0.1",
    "lit": "^3.0.0"
  },
  "overrides": {
    "lit": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-json": "^6.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.0",
    "@types/jest": "^29.5.2",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.5.0",
    "prettier": "^3.9.4",
    "rimraf": "^5.0.1",
    "rollup": "^4.0.0",
    "rollup-plugin-serve": "^3.0.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "tslib": "^2.6.0",
    "typescript": "^5.1.3",
    "typescript-eslint": "^8.62.1"
  },
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "make-version": "node -p \"'export const LIB_VERSION = ' + JSON.stringify(require('./package.json').version) + ';'\" > src/version.ts",
    "prestart": "npm run make-version",
    "prebuild": "npm run make-version",
    "clean": "rimraf dist",
    "start": "rollup -c --watch",
    "build": "rollup -c"
  }
}
